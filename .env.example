# Kamera-Hotspot
CAM_HOST=192.168.43.1
CAM_PORT=11941
# PPCS-UID, Format LBCS-000000-XXXXX
CAM_UID=
CAM_USER=admin
# niemals committen
CAM_PASSWORD=
# z. B. TrailCam_XXXX (nur für Doku/BLE)
WIFI_SSID=
# optional
WIFI_PASSWORD=
# Hex, aus Phase 0 ermittelt; niemals committen
CAM_AES_KEY=
# ecb | cbc-zero | cbc-key  (aus Phase 0)
CAM_AES_MODE=ecb
DOWNLOAD_DIR=./downloads
LOG_LEVEL=INFO
